<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loja - Dashboard de Produtos</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="min-h-screen flex flex-col font-sans text-black bg-white">

    <!-- Cabeçalho (Header) -->
    <%- include('header') %>

    <!-- ALERTA DO SISTEMA (Mostra a mensagem de sucesso ao criar/editar/excluir) -->
    <% if (typeof mensagem !== 'undefined' && mensagem) { %>
        <div class="w-full max-w-[1000px] mx-auto mt-6 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded text-center">
            <%= mensagem %>
        </div>
    <% } %>

    <!-- Conteúdo Principal (Main) -->
    <main class="flex-grow flex flex-col items-center py-12 px-6 w-full max-w-[1000px] mx-auto">

        <!-- Barra de Pesquisa -->
        <div class="w-full max-w-[800px] mb-12">
            <input
                type="text"
                placeholder="Buscar por nome ou categoria..."
                class="w-full border border-black rounded-full px-6 py-3 outline-none focus:ring-1 focus:ring-black placeholder-gray-500"
            >
        </div>

        <!-- Grade de Produtos Dinâmica vinda do Banco de Dados -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10 w-full">
            
            <% if (typeof produtos !== 'undefined' && produtos.length > 0) { %>
                <% produtos.forEach(function(produto) { %>
                    <div class="flex flex-col w-full">
                        
                        <!-- IMAGEM DO PRODUTO (Carregada da pasta /uploads) -->
                        <div class="bg-[#e6e6e6] aspect-square w-full rounded-sm mb-3 flex items-center justify-center overflow-hidden">
                            <% if (produto.imagem1) { %>
                                <img src="/uploads/<%= produto.imagem1 %>" alt="<%= produto.nome %>" class="object-cover w-full h-full">
                            <% } else { %>
                                <span class="text-gray-400 text-sm">Sem imagem</span>
                            <% } %>
                        </div>

                        <!-- Informações: Nome e Preço -->
                        <div class="flex justify-between items-center mb-1 font-semibold text-[15px]">
                            <span><%= produto.nome %></span>
                            <!-- Formata o preço para ter vírgula -->
                            <span>R$ <%= Number(produto.preco).toFixed(2).replace('.', ',') %></span>
                        </div>

                        <!-- Informações: Estoque e Categoria -->
                        <div class="flex justify-between items-center text-gray-500 text-sm mb-4">
                            <span>Estoque: <%= produto.estoque %></span>
                            <span><%= produto.categoria || 'Geral' %></span>
                        </div>

                        <!-- BOTÕES FUNCIONAIS: Remover e Editar -->
                        <div class="flex space-x-3 w-full mt-auto">
                            
                            <!-- Formulário para exclusão -->
                            <form action="/produtos/<%= produto.id %>/excluir" method="POST" class="flex-1" onsubmit="return confirm('Tem certeza que deseja excluir o produto <%= produto.nome %>?');">
                                <button type="submit" class="w-full border border-black text-black font-bold text-[10px] py-2 rounded-full hover:bg-gray-100 transition tracking-widest">
                                    REMOVER
                                </button>
                            </form>
                            
                            <!-- Link para edição -->
                            <a href="/produtos/<%= produto.id %>/editar" class="flex-1 text-center bg-black border border-black text-white font-bold text-[10px] py-2 rounded-full hover:bg-gray-800 transition tracking-widest flex items-center justify-center">
                                EDITAR
                            </a>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-span-full text-center text-gray-500 py-10">
                    Nenhum produto cadastrado na loja. Clique em "+ Adicionar produto" para começar.
                </div>
            <% } %>

        </div>
    </main>

    <!-- Rodapé (Footer) -->
    <footer class="w-full border-t border-black mt-16 py-12 px-8 lg:px-32 flex flex-col md:flex-row justify-between">
        <div class="flex flex-col items-center md:items-start mb-10 md:mb-0 md:mr-16 md:w-1/3">
            <div class="text-2xl font-medium mb-10">Loja</div>
            <div class="flex space-x-6 text-gray-400 text-lg">
                <a href="#" class="hover:text-black transition"><i class="fa-brands fa-facebook-f"></i></a>
                <a href="#" class="hover:text-black transition"><i class="fa-brands fa-linkedin-in"></i></a>
                <a href="#" class="hover:text-black transition"><i class="fa-brands fa-youtube"></i></a>
                <a href="#" class="hover:text-black transition"><i class="fa-brands fa-instagram"></i></a>
            </div>
        </div>
        <div class="flex space-x-24 md:w-1/2 justify-center md:justify-start">
            <div class="flex flex-col space-y-4">
                <h4 class="font-bold text-sm mb-2">Tópico</h4>
                <a href="#" class="text-gray-500 text-sm hover:text-black">Página</a>
                <a href="#" class="text-gray-500 text-sm hover:text-black">Página</a>
            </div>
            <div class="flex flex-col space-y-4">
                <h4 class="font-bold text-sm mb-2">Tópico</h4>
                <a href="#" class="text-gray-500 text-sm hover:text-black">Página</a>
                <a href="#" class="text-gray-500 text-sm hover:text-black">Página</a>
            </div>
        </div>
    </footer>

</body>
</html>